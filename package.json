{
  "name": "@solarpunkltd/swarm-comment-js",
  "version": "0.0.12",
  "description": "JS library for commenting on Swarm",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "keywords": [
    "swarm",
    "js",
    "comment"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solar-Punk-Ltd/swarm-comment-js"
  },
  "bugs": {
    "url": "https://github.com/Solar-Punk-Ltd/swarm-comment-js/issues"
  },
  "author": "balint.ujvari@solarpunk.buzz",
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --no-cache --max-warnings=5",
    "lint:fix": "pnpm run lint --fix",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "depcheck": "depcheck .",
    "init:husky": "pnpm husky install"
  },
  "dependencies": {
    "@ethersphere/bee-js": "^12.2.1",
    "@solarpunkltd/comment-system": "^1.9.4",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.31.0",
    "vite": "^7.1.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-node-polyfills": "^0.24.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0",
    "pnpm": ">=11.0.0",
    "bee": "2.8.0"
  }
}
